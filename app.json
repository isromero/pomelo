{
  "expo": {
    "name": "Pomelo",
    "slug": "pomelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "pomelo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.pomelo.mobile",
      "icon": "./assets/images/app-icon.png",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.pomelo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FBF5E7",
        "foregroundImage": "./assets/images/pom/pom-symbol.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "locales": {
      "en": {
        "ios": {
          "NSCameraUsageDescription": "Pomelo uses your camera to create a Photo Moment.",
          "NSLocationWhenInUseUsageDescription": "Pomelo uses your location only while you choose a place for a journal entry.",
          "NSPhotoLibraryUsageDescription": "Pomelo uses your photo library to create a Photo Moment."
        }
      },
      "es": {
        "ios": {
          "NSCameraUsageDescription": "Pomelo usa la cámara para crear vuestro Photo Moment.",
          "NSLocationWhenInUseUsageDescription": "Pomelo usa tu ubicación solo mientras eliges un lugar para una entrada del diario.",
          "NSPhotoLibraryUsageDescription": "Pomelo usa vuestra fototeca para crear un Photo Moment."
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Pomelo usa la cámara para crear vuestro Photo Moment.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pomelo usa tu ubicación solo mientras eliges un lugar para una entrada del diario."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF5E7",
          "image": "./assets/images/pom/pom-symbol.png",
          "imageWidth": 124
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PomeloStatusWidget",
              "displayName": "Pomelo Moment",
              "description": "Open today's Pomelo Moment.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      "./plugins/with-pomelo-android-widget",
      "expo-apple-authentication",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
